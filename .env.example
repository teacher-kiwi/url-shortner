# ---- 꼭 바꿀 것

# 단축 주소의 앞부분. 경로 없이, 끝에 / 없이.
BASE_URL=https://s.example.com

# 관리자 화면(/admin) 비밀번호. 8자 이상, 예시값(change-me) 그대로면 서버가 시작하지 않는다.
# 바꾸면 기존 로그인은 모두 풀린다.
ADMIN_PASSWORD=change-me

# ---- 필요하면 바꿀 것

# 화면 제목·로고에 쓰는 이름.
SITE_NAME=단축 주소

# 일별 접속 수·만료일을 나누는 시간대 (IANA 이름).
TIME_ZONE=Asia/Seoul

# 리버스 프록시 컨테이너가 붙어 있는 도커 네트워크 이름 (docker-compose.yml 에서 사용).
PROXY_NETWORK=proxy
